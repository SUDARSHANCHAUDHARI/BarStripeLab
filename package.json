{
  "name": "barstripelab",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "export": "BASE_PATH=/barstripelab next build",
    "deploy:gh": "pnpm export && touch out/.nojekyll && gh-pages -d out"
  },
  "dependencies": {
    "bwip-js": "^4.11.2",
    "html-to-image": "^1.11.13",
    "next": "15.5.24",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.5.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.5",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.18",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "license": "MIT"
}
